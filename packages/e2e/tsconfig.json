{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"fixtures/**/*.ts",
		"tests/**/*.ts",
		"screenshots/**/*.ts",
		"playwright.config.ts",
		"screenshots.config.ts"
	]
}
