{
  "manifest_version": 3,
  "name": "Testudo",
  "short_name": "Testudo",
  "version": "0.2.0",
  "description": "Protect your wallet from malicious EIP-7702 delegations. Real-time bytecode analysis warns you before signing dangerous contracts.",
  "homepage_url": "https://github.com/niccolofant/eip7702-poc",
  "minimum_chrome_version": "116",

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },

  "permissions": [
    "storage",
    "alarms"
  ],

  "options_page": "options.html",
  
  "host_permissions": [
    "https://testudo-api-production.up.railway.app/*",
    "https://eth.blockscout.com/*",
    "https://pub-76c6347fe0fc49d7b1497bc741c11d24.r2.dev/*",
    "https://eth.llamarpc.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["injected.js", "fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Testudo - EIP-7702 Protection",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  }
}
